# Database Configuration (Legacy - for migrations only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trust_census
DB_USER=census_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Database Role Credentials (Separation of Powers)
# Each role has specific permissions - see src/db/migrations/002_database_roles.sql

# API Writer: L1 write-only (Enumerator endpoints)
DB_API_WRITER_USER=api_writer
DB_API_WRITER_PASSWORD=CHANGE_THIS_API_WRITER_PASSWORD

# Audit Writer: L0 append-only (Audit middleware)
DB_AUDIT_WRITER_USER=audit_writer
DB_AUDIT_WRITER_PASSWORD=CHANGE_THIS_AUDIT_WRITER_PASSWORD

# Aggregation Worker: L1 read, L2/L3 write (Background workers)
DB_AGGREGATION_WORKER_USER=aggregation_worker
DB_AGGREGATION_WORKER_PASSWORD=CHANGE_THIS_AGGREGATION_WORKER_PASSWORD

# Analytics Reader: L2/L3 read-only (StateAnalyst, CentralPolicyViewer)
DB_ANALYTICS_READER_USER=analytics_reader
DB_ANALYTICS_READER_PASSWORD=CHANGE_THIS_ANALYTICS_READER_PASSWORD

# Supervisor Reader: L0 read-only (Supervisor endpoints)
DB_SUPERVISOR_READER_USER=supervisor_reader
DB_SUPERVISOR_READER_PASSWORD=CHANGE_THIS_SUPERVISOR_READER_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRY=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
