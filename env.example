# =============================================================================
# Trust-First Caste Census Management System - Environment Configuration
# =============================================================================
# 
# SECURITY: Copy this file to .env and replace ALL placeholder values
# NEVER commit .env to version control
# 
# Generate secure passwords using: openssl rand -base64 32
# Generate JWT secret using: openssl rand -base64 64
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# IMPORTANT: Docker PostgreSQL runs on port 5433
# Port 5432 is reserved for host PostgreSQL and MUST NOT be used
# 
# To start Docker PostgreSQL:
#   docker run -d --name trust-census-postgres \
#     -e POSTGRES_PASSWORD=<your-password> \
#     -e POSTGRES_DB=trust_census \
#     -p 5433:5432 \
#     postgres:16-alpine
# =============================================================================

# Use 127.0.0.1 (not localhost) to force IPv4 and avoid DNS issues
DB_HOST=127.0.0.1
# Port 5433 for Docker PostgreSQL (5432 is reserved for host PostgreSQL)
DB_PORT=5433
DB_NAME=trust_census
DB_USER=postgres
DB_PASSWORD=<GENERATE_SECURE_PASSWORD>

# =============================================================================
# Database Role Credentials (Separation of Powers)
# Each role has specific permissions - see src/db/migrations/002_database_roles.sql
# =============================================================================

# API Writer: L1 write-only (Enumerator endpoints)
DB_API_WRITER_USER=api_writer
DB_API_WRITER_PASSWORD=<GENERATE_SECURE_PASSWORD>

# Audit Writer: L0 append-only (Audit middleware)
DB_AUDIT_WRITER_USER=audit_writer
DB_AUDIT_WRITER_PASSWORD=<GENERATE_SECURE_PASSWORD>

# Aggregation Worker: L1 read, L2/L3 write (Background workers)
DB_AGGREGATION_WORKER_USER=aggregation_worker
DB_AGGREGATION_WORKER_PASSWORD=<GENERATE_SECURE_PASSWORD>

# Analytics Reader: L2/L3 read-only (StateAnalyst, CentralPolicyViewer)
DB_ANALYTICS_READER_USER=analytics_reader
DB_ANALYTICS_READER_PASSWORD=<GENERATE_SECURE_PASSWORD>

# Supervisor Reader: L0 read-only (Supervisor endpoints)
DB_SUPERVISOR_READER_USER=supervisor_reader
DB_SUPERVISOR_READER_PASSWORD=<GENERATE_SECURE_PASSWORD>

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=<GENERATE_64_CHAR_RANDOM_STRING>
JWT_EXPIRY=24h

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# =============================================================================
# Security
# =============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# CORS (comma-separated origins, leave empty for development)
CORS_ORIGIN=
